{
  "manifest_version": 3,
  "name": "Shopee Aff Tool",
  "version": "1.0",
  "description": "Tự động tạo link affiliate Shopee",

  "permissions": [
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://affiliate.shopee.vn/*"
  ],

  "externally_connectable": {
    "matches": [
      "https://huy981018-cyber.github.io/*"
    ]
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://affiliate.shopee.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Shopee Aff Tool"
  }
}
